msgstr "Неверный ключ Akismet. Обратитесь в службу поддержки."

#: _inc/lib/core-api/class.jetpack-core-api-module-endpoints.php:950
#: _inc/lib/core-api/class.jetpack-core-api-module-endpoints.php:1495
msgid "Please activate Akismet."
msgstr "Активируйте Akismet."

#: _inc/lib/core-api/class.jetpack-core-api-module-endpoints.php:944
#: _inc/lib/core-api/class.jetpack-core-api-module-endpoints.php:1491
msgid "Please install Akismet."
msgstr "Установите Akismet."

#: _inc/lib/core-api/class.jetpack-core-api-module-endpoints.php:1421
