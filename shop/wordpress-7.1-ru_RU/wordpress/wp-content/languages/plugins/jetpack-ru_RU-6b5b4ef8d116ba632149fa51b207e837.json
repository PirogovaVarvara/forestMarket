3a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u0432 \u0434\u0440\u0443\u0433\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0432\u044b \u043e\u0442\u043a\u0440\u044b\u043b\u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440."],"Something went wrong applying your edits.":["\u041f\u0440\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u043f\u0440\u0430\u0432\u043e\u043a \u0447\u0442\u043e-\u0442\u043e \u043f\u043e\u0448\u043b\u043e \u043d\u0435 \u0442\u0430\u043a."],"The private video could not be loaded.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0435 \u0432\u0438\u0434\u0435\u043e."],"The original video is unavailable.":["\u0418\u0441\u0445\u043e\u0434\u043d\u043e\u0435 \u0432\u0438\u0434\u0435\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e."],"This video is processing. You can leave this page and come back later.":["\u042d\u0442\u043e \u0432\u0438\u0434\u0435\u043e \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u044d\u0442\u0443 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0438 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043f\u043e\u0437\u0436\u0435."],"Restore original\u2026":["\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u0441\u0445\u043e\u0434\u043d\u043e\u0433\u043e \u0432\u0438\u0434\u0435\u043e\u2026"],"Trim & cut":["\u041e\u0431\u0440\u0435\u0437\u0430\u0442\u044c \u0438 \u0432\u044b\u0440\u0435\u0437\u0430\u0442\u044c"],"Host, manage, customize, and track your videos \u2014 all in one place. <link>Learn more<\/link>.":["\u0420\u0430\u0437\u043c\u0435\u0449\u0435\u043d\u0438\u0435, \u0443\u043f\u0440\u0430\u0432\u043b\