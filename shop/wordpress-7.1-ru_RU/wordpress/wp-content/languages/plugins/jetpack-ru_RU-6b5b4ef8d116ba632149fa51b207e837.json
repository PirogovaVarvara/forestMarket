441\u044f. \u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u0441\u0442\u0430\u043d\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438."],"You have unsaved chapter changes. Leave this page and discard them?":["\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u043d\u0435\u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0433\u043b\u0430\u0432\u0430\u0445. \u041f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0438 \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u0445?"],"Back to Library":["\u041d\u0430\u0437\u0430\u0434 \u043a \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435"],"We couldn't find that video.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043d\u0430\u0439\u0442\u0438 \u044d\u0442\u043e \u0432\u0438\u0434\u0435\u043e."],"Your unsaved chapter changes will be discarded and the chapters will return to the last saved version.":["\u041d\u0435\u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0433\u043b\u0430\u0432 \u0431\u0443\u0434\u0443\u0442 \u0441\u0431\u0440\u043e\u0448\u0435\u043d\u044b, \u0438 \u0433\u043b\u0430\u0432\u044b \u0432\u0435\u0440\u043d\u0443\u0442\u0441\u044f \u043a \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438."],"Discard changes?":["\u041e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f?"],"Editing tools":["\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f"],"Editor":["\u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440"],"VideoPress needs a connection to WordPress.com before you can upload and manage your videos.":["\u0427\u0442\u043e\u0431\u044b \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0442\u044c \u0432\u0438\u0434\u0435\u043e \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0438\u043c\u0438, VideoPress \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043a WordPress.com."],"Connect to set up VideoPress":["\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c VideoPress"],"Video chapters could not be updated.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \u0433\u043b\u0430\u0432\u044b \u0432\u0438\u0434\u0435\u043e."],"Chapters cannot start after the video ends.":["\u0413\u043b\u0430\u0432\u044b \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0432\u0438\u0434\u0435\u043e."],"Chapters must be at least 10 seconds apart.":["\u0418\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u043c\u0435\u0436\u0434\u0443 \u0433\u043b\u0430\u0432\u0430\u043c\u0438 \u0434\u043e\u043b\u0436\u0435\u043d \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 10 \u0441\u0435\u043a\u0443\u043d\u0434."],"Chapters must be in ascending order without repeated timestamps.":["\u0413\u043b\u0430\u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u0438\u0434\u0442\u0438 \u0432 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u043f\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0431\u0435\u0437 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0438\u0445\u0441\u044f \u043e\u0442\u043c\u0435\u0442\u043e\u043a \u0432\u0440\u0435\u043c\u0435\u043d\u0438."],"Every chapter needs a title.":["\u0423 \u043a\u0430\u0436\u0434\u043e\u0439 \u0433\u043b\u0430\u0432\u044b \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435."],"At least three chapters are required.":["\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u0442\u0440\u0438 \u0433\u043b\u0430\u0432\u044b."],"The first chapter must start at 0:00.":["\u041f\u0435\u0440\u0432\u0430\u044f \u0433\u043b\u0430\u0432\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c\u0441\u044f \u0441 \u043e\u0442\u043c\u0435\u0442\u043a\u0438 0:00."],"Add at least three chapters.":["\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u0442\u0440\u0438 \u0433\u043b\u0430\u0432\u044b."],"Zoom level %1$d of %2$d":["\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f %1$d \u0438\u0437 %2$d"],"Timeline zoom":["\u041c\u0430\u0441\u0448\u0442\u0430\u0431 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0448\u043a\u0430\u043b\u044b"],"Fit":["\u0412\u043f\u0438\u0441\u0430\u0442\u044c"],"button: pause timeline preview playback\u0004Pause":["\u041f\u0430\u0443\u0437\u0430"],"Playhead":["\u0423\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f"],"Playhead time":["\u0412\u0440\u0435\u043c\u044f \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f"],"Chapter %d":["\u0413\u043b\u0430\u0432\u0430 %d"],"video preview player error\u0004Playback could not be started.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435."],"The video failed to load.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0432\u0438\u0434\u0435\u043e."],"This video format is not supported by the browser.":["\u042d\u0442\u043e\u0442 \u0444\u043e\u0440\u043c\u0430\u0442 \u0432\u0438\u0434\u0435\u043e \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u043e\u043c."],"The browser could not decode this video.":["\u0411\u0440\u0430\u0443\u0437\u0435\u0440\u0443 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0434\u0435\u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u043e \u0432\u0438\u0434\u0435\u043e."],"The video could not be downloaded.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0432\u0438\u0434\u0435\u043e."],"This video has no playable source.":["\u0423 \u044d\u0442\u043e\u0433\u043e \u0432\u0438\u0434\u0435\u043e \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0439 \u0434\u043b\u044f \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a."],"Chapters appear in the player timeline and help viewers jump to a section. The first chapter always starts at 0:00:00.0.":["\u0413\u043b\u0430\u0432\u044b \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0448\u043a\u0430\u043b\u0435 \u043f\u043b\u0435\u0435\u0440\u0430 \u0438 \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442 \u0437\u0440\u0438\u0442\u0435\u043b\u044f\u043c \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u044c \u043a \u043d\u0443\u0436\u043d\u044b\u043c \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u043c. \u041f\u0435\u0440\u0432\u0430\u044f \u0433\u043b\u0430\u0432\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0441 \u043e\u0442\u043c\u0435\u0442\u043a\u0438 0:00:00.0."],"Chapters for this video are managed by an uploaded VTT file, so they can\u2019t be edited here.":["\u0413\u043b\u0430\u0432\u044b \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0432\u0438\u0434\u0435\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0433\u043e VTT-\u0444\u0430\u0439\u043b\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0438\u0445 \u043d\u0435\u043b\u044c\u0437\u044f \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0437\u0434\u0435\u0441\u044c."],"Now: %s":["\u0421\u0435\u0439\u0447\u0430\u0441: %s"],"Add chapter at playhead":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0433\u043b\u0430\u0432\u0443 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f"],"Remove chapter %d":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0433\u043b\u0430\u0432\u0443 %d"],"Go to %s":["\u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u043a %s"],"Chapter %d title":["\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0433\u043b\u0430\u0432\u044b %d"],"Chapter start: %s":["\u041d\u0430\u0447\u0430\u043b\u043e \u0433\u043b\u0430\u0432\u044b: %s"],"Discard changes":["\u041e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f"],"chapters save outcome\u0004Chapters saved to the description, but they won\u2019t appear in the player until they meet the requirements.":["\u0413\u043b\u0430\u0432\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b \u0432 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0438, \u043d\u043e \u043e\u043d\u0438 \u043d\u0435 \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f \u0432 \u043f\u043b\u0435\u0435\u0440\u0435, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0431\u0443\u0434\u0443\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u044b \u0432\u0441\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f."],"Chapters saved.":["\u0413\u043b\u0430\u0432\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b."],"Failed to save chapters.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0433\u043b\u0430\u0432\u044b."],"Breadcrumbs":["\u041d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0446\u0435\u043f\u043e\u0447\u043a\u0438"],"% off the first year":["% \u0441\u043a\u0438\u0434\u043a\u0438 \u043d\u0430 \u043f\u0435\u0440\u0432\u044b\u0439 \u0433\u043e\u0434"],"Take Action":["\u041f\u0440\u0438\u043d\u044f\u0442\u044c \u043c\u0435\u0440\u044b"],"By continuing you agree to our <tosLink>Terms of Service<\/tosLink> and to <shareDetailsLink>sync your site\u2019s data<\/shareDetailsLink> with us. We\u2019ll check if that email is linked to an existing WordPress.com account or create a new one instantly.":["\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f, \u0432\u044b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0435 \u0441\u0432\u043e\u0451 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435 \u0441 \u043d\u0430\u0448\u0438\u043c\u0438 <tosLink>\u0443\u0441\u043b\u043e\u0432\u0438\u044f\u043c\u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0443\u0441\u043b\u0443\u0433<\/tosLink> \u0438 \u0433\u043e\u0442\u043e\u0432\u043d\u043e\u0441\u0442\u044c <shareDetailsLink>\u0441\u0438\u043d\u