0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0435\u0439."],"Subtitle %1$d overlaps subtitle %2$d.":["\u0421\u0443\u0431\u0442\u0438\u0442\u0440 %1$d \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0441\u0443\u0431\u0442\u0438\u0442\u0440 %2$d."],"Subtitle %d must end after it starts.":["\u0412\u0440\u0435\u043c\u044f \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430 %d \u0434\u043e\u043b\u0436\u043d\u043e \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c \u0437\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u043d\u0430\u0447\u0430\u043b\u0430."],"Subtitle %d has an invalid timestamp.":["\u041d\u0435\u0432\u0435\u0440\u043d\u0430\u044f \u043e\u0442\u043c\u0435\u0442\u043a\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430 %d."],"Subtitle %d needs start and end times before publishing.":["\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0443\u043a\u0430\u0437\u0430\u0442\u044c \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0447\u0430\u043b\u0430 \u0438 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430 %d \u043f\u0435\u0440\u0435\u0434 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0435\u0439."],"Subtitle %d needs text before publishing.":["\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0432\u0432\u0435\u0441\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0432 \u0441\u0443\u0431\u0442\u0438\u0442\u0440 %d \u043f\u0435\u0440\u0435\u0434 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0435\u0439."],"Ready":["\u0413\u043e\u0442\u043e\u0432\u043e"],"Failed: %s":["\u041e\u0448\u0438\u0431\u043a\u0430: %s"],"Auto-generated":["\u0421\u043e\u0437\u0434\u0430\u043d\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438"],"Add subtitle":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u044b"],"Create cues":["\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438"],"button: replace the existing subtitle cues with the pasted text\u0004Replace":["\u0417\u0430\u043c\u0435\u043d\u0438\u0442\u044c"],"Append":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c"],"Paste timed captions to keep their timings, or plain text to create evenly spaced cues.":["\u0412\u0441\u0442\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u0438 \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u0438 \u043f\u043e\u044f\u0432\u043b\u044f\u043b\u0438\u0441\u044c \u0432 \u043d\u0443\u0436\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442, \u0438\u043b\u0438 \u0436\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0442\u0435\u043a\u0441\u0442, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0435 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438."],"Subtitle text":["\u0422\u0435\u043a\u0441\u0442 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432"],"Keyboard shortcuts: Space plays or pauses the preview, the Left and Right arrow keys seek, C adds a subtitle at the playhead, N and P jump to the next or previous subtitle, and Control+Z or Command+Z undoes an edit (add Shift to redo).":["\u0413\u043e\u0440\u044f\u0447\u0438\u0435 \u043a\u043b\u0430\u0432\u0438\u0448\u0438: \u043a\u043b\u0430\u0432\u0438\u0448\u0430 \u00ab\u041f\u0440\u043e\u0431\u0435\u043b\u00bb \u2014 \u0437\u0430\u043f\u0443\u0441\u043a \u0438\u043b\u0438 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u043d\u0430 \u043f\u0430\u0443\u0437\u0443 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430; \u043a\u043b\u0430\u0432\u0438\u0448\u0438 \u0441\u043e \u0441\u0442\u0440\u0435\u043b\u043a\u0430\u043c\u0438 \u0432\u043b\u0435\u0432\u043e \u0438 \u0432\u043f\u0440\u0430\u0432\u043e \u2014 \u043f\u043e\u0438\u0441\u043a, \u043a\u043b\u0430\u0432\u0438\u0448\u0430 C \u2014 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 \u0432 \u0442\u043e\u0447\u043a\u0435 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f, N \u0438 P \u2014 \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u043a \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 (Next) \u0438\u043b\u0438 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0435\u0439 (Previous) \u0441\u0442\u0440\u043e\u043a\u0435 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432, Control+Z \u0438\u043b\u0438 Command+Z \u2014 \u043e\u0442\u043c\u0435\u043d\u0430 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f (Shift \u2014 \u043f\u043e\u0432\u0442\u043e\u0440 \u043e\u0442\u043c\u0435\u043d\u0451\u043d\u043d\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f)."],"Subtitle editing workspace":["\u0420\u0430\u0431\u043e\u0447\u0435\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432"],"Add a subtitle cue.":["\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0443 \u0434\u043b\u044f \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432."],"No subtitle tracks have been added to this video yet.":["\u0412 \u044d\u0442\u043e\u043c \u0432\u0438\u0434\u0435\u043e \u0435\u0449\u0451 \u043d\u0435\u0442 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432"],"Paste transcript":["\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443"],"Add track":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0434\u043e\u0440\u043e\u0436\u043a\u0443"],"button: overwrite an already-published subtitle track\u0004Update":["\u041e\u0431\u043d\u043e\u0432\u0438\u0442\u044c"],"Save draft":["\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a"],"Paste text":["\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0442\u0435\u043a\u0441\u0442"],"Back to tracks":["\u041d\u0430\u0437\u0430\u0434 \u043a \u0434\u043e\u0440\u043e\u0436\u043a\u0430\u043c \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432"],"Loading subtitle content\u2026":["\u0417\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432..."],"Subtitle tracks":["\u0414\u043e\u0440\u043e\u0436\u043a\u0438 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432"],"New subtitle track":["\u041d\u043e\u0432\u0430\u044f \u0434\u043e\u0440\u043e\u0436\u043a\u0430 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432"],"Edit subtitle track":["\u0420\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0434\u043e\u0440\u043e\u0436\u043a\u0443 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432"],"Upload subtitle file":["\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0444\u0430\u0439\u043b \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432"],"Replace subtitle file":["\u0417\u0430\u043c\u0435\u043d\u0438\u0442\u044c \u0444\u0430\u0439\u043b \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432"],"Drop a subtitle file to upload":["\u041f\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u044c \u0444\u0430\u0439\u043b \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 \u0434\u043b\u044f \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438"],"Manage subtitles for %s":["\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430\u043c\u0438 \u0432 %s"],"Manage subtitles for %1$s: %2$s":["\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430\u043c\u0438 \u0432 %1$s: %2$s"],"VideoPress video":["\u0412\u0438\u0434\u0435\u043e VideoPress"],"Delete the %s subtitle draft? This cannot be undone.":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 %s? \u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c."],"Delete the %s subtitle track? This cannot be undone.":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0434\u043e\u0440\u043e\u0436\u043a\u0443 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 %s? \u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c."],"Paste subtitle text before importing.":["\u0412\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 \u043f\u0435\u0440\u0435\u0434 \u0438\u043c\u043f\u043e\u0440\u0442\u043e\u043c."],"Subtitle text imported.":["\u0422\u0435\u043a\u0441\u0442 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d."],"Subtitles published, but the previous language\u2019s track couldn\u2019t be removed and may still appear.":["\u0421\u0443\u0431\u0442\u0438\u0442\u0440\u044b \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b, \u043d\u043e \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0443\u044e \u0434\u043e\u0440\u043e\u0436\u043a\u0443 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u043c \u044f\u0437\u044b\u043a\u0435 \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0438 \u043e\u043d\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f."],"Subtitles published.":["\u0421\u0443\u0431\u0442\u0438\u0442\u0440\u044b \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b."],"Add at least one subtitle cue before publishing.":["\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0445\u043e\u0442\u044f \u0431\u044b \u043e\u0434\u043d\u0443 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0443 \u0434\u043b\u044f \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 \u043f\u0435\u0440\u0435\u0434 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0435\u0439."],"Choose a subtitle language.":["\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u044f\u0437\u044b\u043a \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432."],"Subtitle track uploaded, but the previous language\u2019s track couldn\u2019t be removed and may still appear.":["\u0414\u043e\u0440\u043e\u0436\u043a\u0430 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u0430, \u043d\u043e \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0443\u044e \u0434\u043e\u0440\u043e\u0436\u043a\u0443 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u043c \u044f\u0437\u044b\u043a\u0435 \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0438 \u043e\u043d\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f."],"Subtitle track uploaded.":["\u0414\u043e\u0440\u043e\u0436\u043a\u0430 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u0430."],"Accepted formats: %s.":["\u0414\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b\u0435 \u0444\u043e\u0440\u043c\u0430\u0442\u044b: %s."],"Unable to load subtitle content. You can try again from the track list or start from an empty subtitle track.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443, \u043d\u0430\u0447\u0430\u0432 \u0441\u043e \u0441\u043f\u0438\u0441\u043a\u0430 \u0434\u043e\u0440\u043e\u0436\u0435\u043a \u0438\u043b\u0438 \u0437\u0430\u043d\u043e\u0432\u043e \u0441 \u043f\u0443\u0441\u0442\u043e\u0439 \u0434\u043e\u0440\u043e\u0436\u043a\u0438."],"Discard unsaved subtitle changes?":["\u041e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u043d\u0435\u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430\u0445?"],"Couldn\u2019t load saved subtitle drafts. Any existing drafts may not appear.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043e\u0432. \u0418\u043c\u0435\u044e\u0449\u0438\u0435\u0441\u044f \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u043d\u0435 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f."],"Couldn\u2019t load the latest track list for this video. It may be incomplete.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 \u0434\u043e\u0440\u043e\u0436\u0435\u043a \u0432 \u044d\u0442\u043e\u043c \u0